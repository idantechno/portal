# Copy to .env and edit as needed.

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated allowlist in prod (e.g. https://app.portalstudio.co.il).
# '*' allows any origin — dev only.
CORS_ORIGIN=http://localhost:5173
# Public base URL of the frontend app — used to build OAuth return redirects.
APP_PUBLIC_URL=http://localhost:5173

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated emails promoted to super_admin on startup (operator accounts).
# Sign up normally first, then add your email here and restart the backend.
SUPER_ADMIN_EMAILS=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Default model used by the agent worker.
AGENT_MODEL=claude-sonnet-4-6
# How many agent runs the worker processes in parallel (tune to API rate limits).
AGENT_WORKER_CONCURRENCY=5
# Hard wall-clock cap (ms) per agent run before it's aborted and retried.
AGENT_RUN_TIMEOUT_MS=120000

# --- Encryption ---
# 32-byte key, base64-encoded. Used to encrypt sensitive per-business secrets
# (WhatsApp access tokens) at rest in Postgres.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Meta / WhatsApp Cloud API (SaaS-shaped: one app, one webhook for all businesses) ---
# Our Meta App credentials. Customers connect their WABA to us via Embedded
# Signup; they never touch developers.facebook.com.
META_APP_ID=
META_APP_SECRET=
# Static verify token Meta echoes during webhook verification. Generate with:
# openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# The Embedded Signup "configuration ID" Meta issues for our WABA Tech Provider
# flow. Passed to FB.login on the frontend.
META_EMBEDDED_SIGNUP_CONFIG_ID=

# --- 360dialog (WhatsApp BSP — how WhatsApp actually sends & receives) ---
# We resell WhatsApp under 360dialog (a Meta Tech Provider). Outbound goes to
# their Cloud-API proxy; inbound arrives on /api/webhooks/whatsapp/360dialog/
# :businessId. The per-business API key is stored ENCRYPTED in the
# whatsapp_connections row (set via POST .../channels/whatsapp/360dialog), never
# here. 360dialog's messaging API base — 1:1 Cloud API proxy; rarely changed.
DIALOG360_API_BASE=https://waba-v2.360dialog.io
# Server secret used to derive each business's inbound webhook token
# (HMAC-SHA256(businessId)). 360dialog doesn't sign payloads, so this token in
# the webhook URL is what authenticates inbound. Generate: openssl rand -hex 32
DIALOG360_WEBHOOK_SECRET=
# Public base URL of THIS backend, used to build the webhook URL you paste into
# 360dialog. Prod: https://api.portalstudio.co.il
API_PUBLIC_URL=http://localhost:3000

# --- Marketing questionnaire (public /strategy page) ---
# The operator's own business that tenant-less marketing leads attach to.
# Leave blank to auto-resolve to the earliest super-admin-owned business.
PLATFORM_BUSINESS_ID=
# Where questionnaire submissions are emailed. Sent via the platform business's
# connected Gmail (must connect Gmail once under Integrations for this to work).
OPERATOR_NOTIFY_EMAIL=ai@portalstudio.art
# Operator WhatsApp number (E.164, no +) for the submission ping. Best-effort —
# only fires once the Meta Cloud API is unblocked. Leave blank to disable the
# WhatsApp path (email still sends). Business number 0515223921 → E.164:
OPERATOR_NOTIFY_WHATSAPP=972515223921

# --- Business storage ---
# Path inside the api/worker containers. A host directory is bind-mounted here
# in docker-compose; it holds /{businessId}/<context files> per tenant.
BUSINESSES_DIR=/data/businesses
# Host-side directory mounted into the containers. Created on first `make dev`.
BUSINESSES_HOST_DIR=./.data/businesses

# --- Postgres ---
DB_HOST=postgres
DB_PORT=5432
# Host-side port mapping (change if 5432 is already in use locally — e.g. 5433)
DB_HOST_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=portal
# Dev: auto-create schema from entities. PROD: set to false — the app then runs
# TypeORM migrations automatically on boot (use `pnpm migration:generate` to add
# a migration after changing entities).
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Redis (BullMQ queues + Socket.IO adapter) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
# Required by the managed Redis on Railway; leave blank for local open Redis.
REDIS_USERNAME=
REDIS_PASSWORD=

# --- Google OAuth (Gmail + Calendar integrations) ---
# From the Google Cloud Console OAuth client. Redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Billing providers ---
# Green Invoice (חשבונית ירוקה) — primary invoicing for Israel.
GREEN_INVOICE_API_KEY=
# Stripe — optional/experimental (ruled out for Israel clearing; checkout only).
STRIPE_SECRET_KEY=

# --- Compose host-side port overrides ---
# Dev — host ports for the dev stack. Bump these if you have collisions.
BACKEND_HOST_PORT=3000
BACKEND_DEBUG_HOST_PORT=9229
FRONTEND_HOST_PORT=5173
# Prod
FRONTEND_PORT=8080
ADMINER_PORT=8081

# --- Frontend (build-time) ---
VITE_API_URL=/api
VITE_WS_URL=/
# Meta App ID (public) + Embedded Signup config ID, consumed by the FB JS SDK.
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v21.0
